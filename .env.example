APP_ENV=development
APP_VERSION=0.2.0
CORS_ORIGINS=http://localhost:3000

# Structured transactional source of truth
DATABASE_URL=postgresql+psycopg://smartdoctor:smartdoctor_dev_only@localhost:5432/smartdoctor

# Ephemeral cache
REDIS_URL=redis://localhost:6379/0

# Conversation history (MongoDB)
MONGODB_URL=mongodb://smartdoctor:smartdoctor_dev_only@localhost:27017/?authSource=admin
MONGODB_DATABASE=smartdoctor

# RAG vector index (Qdrant)
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=patient_records
EMBEDDING_DIMENSIONS=1536

# Configure these from your trusted OIDC provider before enabling authenticated API access.
OIDC_ISSUER=
OIDC_AUDIENCE=
OIDC_JWKS_URL=
