APP_ENV=development
APP_VERSION=0.3.0
CORS_ORIGINS=http://localhost:3000
DATABASE_URL=postgresql+psycopg://smartdoctor:smartdoctor_dev_only@localhost:5432/smartdoctor
REDIS_URL=redis://localhost:6379/0
MONGODB_URL=mongodb://smartdoctor:smartdoctor_dev_only@localhost:27017/?authSource=admin
MONGODB_DATABASE=smartdoctor
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=patient_records
EMBEDDING_DIMENSIONS=384
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
UPLOAD_DIRECTORY=./data/uploads
MAX_UPLOAD_MB=20

# Local demo auth is intentionally opt-in and must never be enabled outside development.
DEV_AUTH_ENABLED=true

# Optional OpenAI-compatible chat endpoint (Ollama, vLLM, or hosted provider).
LLM_BASE_URL=
LLM_API_KEY=local-dev
LLM_MODEL=qwen2.5:3b

# Configure a trusted OIDC provider for authenticated non-demo use.
OIDC_ISSUER=
OIDC_AUDIENCE=
OIDC_JWKS_URL=
OIDC_ROLES_CLAIM=roles
OIDC_ORGANIZATION_CLAIM=organization_id


# Auth.js OIDC client. Register:
# http://localhost:3000/api/auth/callback/smartdoctor-oidc
AUTH_SECRET=replace-with-a-random-secret-at-least-32-characters
AUTH_URL=http://localhost:3000
AUTH_TRUST_HOST=true
AUTH_OIDC_ISSUER=
AUTH_OIDC_CLIENT_ID=
AUTH_OIDC_CLIENT_SECRET=
AUTH_OIDC_AUDIENCE=
AUTH_OIDC_SCOPE=openid profile email
NEXT_PUBLIC_OIDC_ENABLED=false
NEXT_PUBLIC_OIDC_SIGNUP_URL=
NEXT_PUBLIC_OIDC_PASSWORD_RESET_URL=
