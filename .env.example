APP_ENV=development
APP_VERSION=0.3.0
CORS_ORIGINS=http://localhost:3000
DATABASE_URL=postgresql+psycopg://smartdoctor:smartdoctor_dev_only@localhost:5432/smartdoctor
REDIS_URL=redis://localhost:6379/0
MONGODB_URL=mongodb://smartdoctor:smartdoctor_dev_only@localhost:27017/?authSource=admin
MONGODB_DATABASE=smartdoctor
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=patient_records
EMBEDDING_DIMENSIONS=384
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
UPLOAD_DIRECTORY=./data/uploads
MAX_UPLOAD_MB=20

# Local synthetic demo is development-only.
DEV_AUTH_ENABLED=true

# Auth JWT signing secret: generate a unique random value (at least 32 chars) for every environment.
AUTH_JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
AUTH_ACCESS_MINUTES=15
AUTH_REFRESH_DAYS=30
AUTH_OTP_MINUTES=10
AUTH_OTP_MAX_ATTEMPTS=5
AUTH_OTP_RESEND_SECONDS=60
# Development only: return development_otp for local testing when SMTP is not configured.
AUTH_DEV_OTP_ENABLED=true
# Comma-separated trusted bootstrap admin email addresses (must verify email).
AUTH_ADMIN_EMAILS=
AUTH_SUPER_ADMIN_EMAILS=superadmin@demo.example.com # Configure only trusted platform owner addresses

# SMTP: required in production. Example: smtp.gmail.com / 587 with an app password.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true

# Optional legacy OIDC compatibility while migrating clients.
OIDC_ISSUER=
OIDC_AUDIENCE=
OIDC_JWKS_URL=
OIDC_ROLES_CLAIM=roles
OIDC_ORGANIZATION_CLAIM=organization_id

LLM_BASE_URL=
LLM_API_KEY=local-dev
LLM_MODEL=qwen2.5:3b

# Legacy Auth.js values; frontend migration follows after backend tests.
AUTH_SECRET=replace-with-a-random-secret-at-least-32-characters
AUTH_URL=http://localhost:3000
AUTH_TRUST_HOST=true
AUTH_OIDC_ISSUER=
AUTH_OIDC_CLIENT_ID=
AUTH_OIDC_CLIENT_SECRET=
AUTH_OIDC_AUDIENCE=
AUTH_OIDC_SCOPE=openid profile email
NEXT_PUBLIC_OIDC_ENABLED=false
NEXT_PUBLIC_OIDC_SIGNUP_URL=
NEXT_PUBLIC_OIDC_PASSWORD_RESET_URL=
